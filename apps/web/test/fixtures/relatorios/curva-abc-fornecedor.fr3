<TfrxReport Version="4.15.13" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="42767,6155110995" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TotalNF, PercAcumuladoABC, &#13;&#10;  PercABC, PercA, PercB, PercC  : Extended;&#13;&#10;  ContaPass : Integer;                                              &#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   if Engine.FinalPass then&#13;&#10;   begin&#13;&#10;      ContaPass := ContaPass + 1;                                                    &#13;&#10;      PercA := (&#60;dbdConsulta.&#34;PC_CURVA_ABC_A&#34;&#62;);&#13;&#10;      PercB := (&#60;dbdConsulta.&#34;PC_CURVA_ABC_A&#34;&#62;) + (&#60;dbdConsulta.&#34;PC_CURVA_ABC_B&#34;&#62;);&#13;&#10;      PercC := (&#60;dbdConsulta.&#34;PC_CURVA_ABC_A&#34;&#62;) + (&#60;dbdConsulta.&#34;PC_CURVA_ABC_B&#34;&#62;) + (&#60;dbdConsulta.&#34;PC_CURVA_ABC_C&#34;&#62;);              &#13;&#10;  &#13;&#10;      PercABC := (((&#60;dbdConsulta.&#34;TOTALNF&#34;&#62;) * 100) / TotalNF);&#13;&#10;      PercAcumuladoABC     := PercAcumuladoABC + PercABC;&#13;&#10;      mmPercAcumulado.Text := FormatFloat(',0.00', PercAcumuladoABC);                                   &#13;&#10;      mmPercABC.Text       := FormatFloat(',0.0000', PercABC);&#13;&#10;        &#13;&#10;      if ContaPass = 1 then&#13;&#10;         mmABC.Text := 'A'&#13;&#10;      else if (PercAcumuladoABC &#60;= PercA) then&#13;&#10;         mmABC.Text := 'A'&#13;&#10;      else if (PercAcumuladoABC &#62; PercA) and (PercAcumuladoABC &#60;= PercB) then&#13;&#10;         mmABC.Text := 'B'&#13;&#10;      else if (PercAcumuladoABC &#62; PercB) and (PercAcumuladoABC &#60;= PercC) then&#13;&#10;         mmABC.Text := 'C';                                              &#13;&#10;   end&#13;&#10;   else               &#13;&#10;      TotalNF := TotalNF + (&#60;dbdConsulta.&#34;TOTALNF&#34;&#62;);                     &#13;&#10;end;           &#13;&#10;&#13;&#10;procedure frxReport1OnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   PercA            := 0;&#13;&#10;   PercB            := 0;&#13;&#10;   PercC            := 0;       &#13;&#10;   PercABC          := 0;&#13;&#10;   ContaPass        := 0;                                                                      &#13;&#10;   TotalNF          := 0;&#13;&#10;   PercAcumuladoABC := 0;            &#13;&#10;end;  &#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" OnStartReport="frxReport1OnStartReport" PropData="">
