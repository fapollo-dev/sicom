CUSTO&#34;&#62;,MasterData1)]';      &#13;&#10;totVenda.Text := '[SUM(&#60;frxDBDProd.&#34;TOTAL_VENDA&#34;&#62;,MasterData1)]';                                                            &#13;&#10;  &#13;&#10;end&#13;&#10;else if DEP_ESTOQUE.text = 'Disponível em : Estoque' then             &#13;&#10;begin&#13;&#10;&#13;&#10;totSaldo.Text := '[SUM(&#60;frxDBDProd.&#34;QTDE_ESTOQUE&#34;&#62;,MasterData1)]';      &#13;&#10;totCusto.Text := '[SUM(&#60;frxDBDProd.&#34;CUSTO_ESTOQUE&#34;&#62;,MasterData1)]';      &#13;&#10;totVenda.Text := '[SUM(&#60;frxDBDProd.&#34;VENDA_ESTOQUE&#34;&#62;,MasterData1)]';    &#13;&#10;  &#13;&#10;end&#13;&#10;else if DEP_ESTOQUE.text = 'Disponível em : Deposito' then                &#13;&#10;begin  &#13;&#10;                   &#13;&#10;totSaldo.Text := '[SUM(&#60;frxDBDProd.&#34;QTDE_DEPOSITO&#34;&#62;,MasterData1)]';      &#13;&#10;totCusto.Text := '[SUM(&#60;frxDBDProd.&#34;CUSTO_DEPOSITO&#34;&#62;,MasterData1)]';      &#13;&#10;totVenda.Text := '[SUM(&#60;frxDBDProd.&#34;VENDA_DEPOSITO&#34;&#62;,MasterData1)]';      &#13;&#10;end; }    &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;  &#13;&#10;end.             " OnStartReport="frxReport1OnStartReport">
