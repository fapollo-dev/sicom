<TfrxReport Version="4.15.13" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="43031,7297587153" ScriptLanguage="PascalScript" ScriptText.Text="procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var a : integer;                                         &#13;&#10;begin&#13;&#10;   if (&#60;dbdRelatorio.&#34;ID&#34;&#62; = 0) then&#13;&#10;   begin               &#13;&#10;      mmTitulo.Font.Style := 1;&#13;&#10;      mmTitulo.Font.Size  := 10;&#13;&#10;      Line1.Visible       := True;&#13;&#10;      mmSemana1.Text := '';&#13;&#10;      mmSemana2.Text := '';&#13;&#10;      mmSemana3.Text := '';&#13;&#10;      mmSemana4.Text := '';&#13;&#10;      mmSemana5.Text := '';&#13;&#10;      mmTotal.Text   := '';&#13;&#10;      mmSemana1Perc.Text := '';&#13;&#10;      mmSemana2Perc.Text := '';&#13;&#10;      mmSemana3Perc.Text := '';&#13;&#10;      mmSemana4Perc.Text := '';&#13;&#10;      mmSemana5Perc.Text := '';&#13;&#10;      mmTotalPerc.Text   := '';          &#13;&#10;   end                   &#13;&#10;   else&#13;&#10;   begin               &#13;&#10;      mmTitulo.Font.Style := 0;&#13;&#10;      mmTitulo.Font.Size  := 10;&#13;&#10;      Line1.Visible       := False;&#13;&#10;      if (&#60;dbdRelatorio.&#34;TITULO&#34;&#62; = 'Num. Clientes') or&#13;&#10;         (&#60;dbdRelatorio.&#34;TITULO&#34;&#62; = 'Dif Num. Clientes') then&#13;&#10;      begin          &#13;&#10;         mmSemana1.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_1&#34;&#62;);&#13;&#10;         mmSemana2.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_2&#34;&#62;);&#13;&#10;         mmSemana3.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_3&#34;&#62;);&#13;&#10;         mmSemana4.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_4&#34;&#62;);&#13;&#10;         mmSemana5.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_5&#34;&#62;);&#13;&#10;         mmTotal.Text   := FormatFloat('0', &#60;dbdRelatorio.&#34;TOTAL&#34;&#62;);&#13;&#10;         mmSemana1Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_1_PERC&#34;&#62;);&#13;&#10;         mmSemana2Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_2_PERC&#34;&#62;);&#13;&#10;         mmSemana3Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_3_PERC&#34;&#62;);&#13;&#10;         mmSemana4Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_4_PERC&#34;&#62;);&#13;&#10;         mmSemana5Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_5_PERC&#34;&#62;);&#13;&#10;         mmTotalPerc.Text   := FormatFloat('0', &#60;dbdRelatorio.&#34;TOTAL_PERC&#34;&#62;);             &#13;&#10;      end&#13;&#10;      else&#13;&#10;      begin&#13;&#10;         mmSemana1.Text := FormatFloat(',0', &#60;dbdRelatorio.&#34;SEMANA_1&#34;&#62;);&#13;&#10;         mmSemana2.Text := FormatFloat(',0', &#60;dbdRelatorio.&#34;SEMANA_2&#34;&#62;);&#13;&#10;         mmSemana3.Text := FormatFloat(',0', &#60;dbdRelatorio.&#34;SEMANA_3&#34;&#62;);&#13;&#10;         mmSemana4.Text := FormatFloat(',0', &#60;dbdRelatorio.&#34;SEMANA_4&#34;&#62;);&#13;&#10;         mmSemana5.Text := FormatFloat(',0', &#60;dbdRelatorio.&#34;SEMANA_5&#34;&#62;);&#13;&#10;         mmTotal.Text   := FormatFloat(',0', &#60;dbdRelatorio.&#34;TOTAL&#34;&#62;);&#13;&#10;         mmSemana1Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_1_PERC&#34;&#62;);&#13;&#10;         mmSemana2Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_2_PERC&#34;&#62;);&#13;&#10;         mmSemana3Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_3_PERC&#34;&#62;);&#13;&#10;         mmSemana4Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_4_PERC&#34;&#62;);&#13;&#10;         mmSemana5Perc.Text := FormatFloat('0', &#60;dbdRelatorio.&#34;SEMANA_5_PERC&#34;&#62;);&#13;&#10;         mmTotalPerc.Text   := FormatFloat('0', &#60;dbdRelatorio.&#34;TOTAL_PERC&#34;&#62;);               &#13;&#10;      end;                    &#13;&#10;   end;       &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
