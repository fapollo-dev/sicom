   &#13;&#10;      &#13;&#10;  DescTotal :=DescTotal + DescGeral;  &#13;&#10;&#13;&#10;    &#13;&#10;end;}  &#13;&#10;&#13;&#10;           &#13;&#10;&#13;&#10;procedure MasterData3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;     SALDO_ANTERIOR_TXT := FormatFloat('0.00,;&#34;(&#34;0.00,&#34;)&#34;',&#60;dbdConsulta.&#34;SALDO_ANTERIOR&#34;&#62;);&#13;&#10;     SALDO_ATUAL_TXT := FormatFloat('0.00,;&#34;(&#34;0.00,&#34;)&#34;',&#60;dbdConsulta.&#34;SALDO_ATUAL&#34;&#62;);&#13;&#10;         &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." Left="318" Top="8">
