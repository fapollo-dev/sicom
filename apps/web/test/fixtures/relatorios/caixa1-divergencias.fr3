<TfrxReport Version="4.15.13" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="42895,5832979167" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TotalDivergenciaEmpresa, TotalCX_VendasEmpresa, TotalCaixaEmpresa : TStringList;&#13;&#10;  TotalDivergenciaOperador, TotalCX_VendasOperador, TotalCaixaOperador : TStringList;                                                          &#13;&#10;  TotalDivergenciaData, TotalCX_VendasData, TotalCaixaData : TStringList;&#13;&#10;&#13;&#10;  IndiceEmpresa, IndiceOperador, IndiceData: Integer;&#13;&#10;  &#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin      &#13;&#10;    MemoTotalDivergenciaEmpresa.Text := TotalDivergenciaEmpresa[IndiceEmpresa];&#13;&#10;    MemoTotalCX_VendasEmpresa.Text   := TotalCX_VendasEmpresa[IndiceEmpresa];&#13;&#10;    MemoTotalCaixaEmpresa.Text       := TotalCaixaEmpresa[IndiceEmpresa];        &#13;&#10;    Inc(IndiceEmpresa);            &#13;&#10;  end;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    try                                                       &#13;&#10;      TotalDivergenciaEmpresa.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;DIVERGENCIA&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCX_VendasEmpresa.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CX_VENDAS&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCaixaEmpresa.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CAIXA&#34;&#62;, MasterData1, 1)));          &#13;&#10;    except                       &#13;&#10;    end;                                &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  IndiceEmpresa  := 0;&#13;&#10;  IndiceOperador := 0;&#13;&#10;  IndiceData     := 0;                             &#13;&#10;end;&#13;&#10;&#13;&#10;procedure FrxRelatorioOnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalDivergenciaEmpresa  := TStringList.Create;&#13;&#10;  TotalCX_VendasEmpresa    := TStringList.Create;         &#13;&#10;  TotalCaixaEmpresa        := TStringList.Create;&#13;&#10;    &#13;&#10;  TotalDivergenciaOperador := TStringList.Create;&#13;&#10;  TotalCX_VendasOperador   := TStringList.Create;                      &#13;&#10;  TotalCaixaOperador       := TStringList.Create;&#13;&#10;    &#13;&#10;  TotalDivergenciaData     := TStringList.Create;&#13;&#10;  TotalCX_VendasData       := TStringList.Create;&#13;&#10;  TotalCaixaData           := TStringList.Create;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure FrxRelatorioOnStopReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalDivergenciaEmpresa.Free;&#13;&#10;  TotalCX_VendasEmpresa.Free;&#13;&#10;  TotalCaixaEmpresa.Free;&#13;&#10;&#13;&#10;  TotalDivergenciaOperador.Free;&#13;&#10;  TotalCX_VendasOperador.Free;&#13;&#10;  TotalCaixaOperador.Free;&#13;&#10;&#13;&#10;  TotalDivergenciaData.Free;&#13;&#10;  TotalCX_VendasData.Free;&#13;&#10;  TotalCaixaData.Free;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin      &#13;&#10;    MemoTotalDivergenciaOperador.Text := TotalDivergenciaOperador[IndiceOperador];&#13;&#10;    MemoTotalCX_VendasOperador.Text   := TotalCX_VendasOperador[IndiceOperador];&#13;&#10;    MemoTotalCaixaOperador.Text       := TotalCaixaOperador[IndiceOperador];        &#13;&#10;    Inc(IndiceOperador);            &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter3OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    try                                                       &#13;&#10;      TotalDivergenciaOperador.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;DIVERGENCIA&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCX_VendasOperador.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CX_VENDAS&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCaixaOperador.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CAIXA&#34;&#62;, MasterData1, 1)));          &#13;&#10;    except                       &#13;&#10;    end;                                &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin      &#13;&#10;    MemoTotalDivergenciaData.Text := TotalDivergenciaData[IndiceData];&#13;&#10;    MemoTotalCX_VendasData.Text   := TotalCX_VendasData[IndiceData];&#13;&#10;    MemoTotalCaixaData.Text       := TotalCaixaData[IndiceData];        &#13;&#10;    Inc(IndiceData);            &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter4OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    try                                                       &#13;&#10;      TotalDivergenciaData.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;DIVERGENCIA&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCX_VendasData.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CX_VENDAS&#34;&#62;, MasterData1, 1)));&#13;&#10;      TotalCaixaData.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR_CAIXA&#34;&#62;, MasterData1, 1)));          &#13;&#10;    except                       &#13;&#10;    end;                                &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Masterdata2.DataSet.First;                                                                                                        &#13;&#10;end;    &#13;&#10;&#13;&#10;begin&#13;&#10;  case &#60;DBDVariaveisAdicionais.&#34;NiveisExpandidos&#34;&#62; of&#13;&#10;    1: GroupHeader1.ExpandDrillDown := True;     &#13;&#10;    2:&#13;&#10;    begin&#13;&#10;      GroupHeader1.ExpandDrillDown := True;&#13;&#10;      GroupHeader3.ExpandDrillDown := True;  &#13;&#10;    end;              &#13;&#10;    3:&#13;&#10;    begin&#13;&#10;      GroupHeader1.ExpandDrillDown := True;&#13;&#10;      GroupHeader3.ExpandDrillDown := True;&#13;&#10;      GroupHeader4.ExpandDrillDown := True;  &#13;&#10;    end;              &#13;&#10;  end;        &#13;&#10;end." StoreInDFM="False" OnStartReport="FrxRelatorioOnStartReport" OnStopReport="FrxRelatorioOnStopReport" PropData="">
