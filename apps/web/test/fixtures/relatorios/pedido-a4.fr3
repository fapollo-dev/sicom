<TfrxReport Version="4.15.13" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39750,1408090857" ReportOptions.Description.Text="" ReportOptions.LastChange="43049,6230837269" ScriptLanguage="PascalScript" ScriptText.Text="var Linha, MaxLinha : Integer;&#13;&#10;    Texto1, Texto2, texto3 :String;                                                                        &#13;&#10;    total: double;&#13;&#10;&#13;&#10;procedure btnOkOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;if rbUsuario.checked then&#13;&#10;begin&#13;&#10;{Oculta campo descontos}                                                                 &#13;&#10;Memo20.visible := false;&#13;&#10;Memo21.visible := false;    &#13;&#10;end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxReport1OnRunDialogs(var Result: Boolean);&#13;&#10;begin&#13;&#10;    result := DialogPage1.showModal = mrOk;                                                                                                                                           &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rbUsuarioOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if  rbUsuario.checked then&#13;&#10;  rbNormal.checked := false;                                                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rbNormalOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if rbNormal.checked then&#13;&#10;  rbUsuario.checked := false;                                                                             &#13;&#10;end;        &#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; &#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(Linha);&#13;&#10;  MemoCount.text :='Registros: '+IntToStr(Linha);        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ColumnFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   {while Linha&#60;= 9 do&#13;&#10;   begin&#13;&#10;      Engine.ShowBand(Child1);&#13;&#10;      Inc(Linha);&#13;&#10;   end;}         &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    Linha    := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportTitle1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; //  MaxLinha := 8;&#13;&#10;   //if  Memo25.text = '' then&#13;&#10;  // begin&#13;&#10;   // MasterData1.Height :=  0.52;&#13;&#10;  //  Memo25.visible := False;                                                                        &#13;&#10; //  end;       &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxDBDataset1DESCRICAOOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; total := total +  &#60;frxDBDataset1.&#34;QTDE&#34;&#62; *  &#60;frxDBDataset1.&#34;PESO&#34;&#62;;  &#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure mmTotalLOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   mmtotalB.text := '  Peso Bruto: ' + formatFloat(',0.00',Total);&#13;&#10;   mmtotall.text := 'Peso Líquido: ' + formatFloat(',0.00',Total);         &#13;&#10;end;&#13;&#10;&#13;&#10;procedure mmTotalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; mmTotal.Text :=  formatFloat(',0.00',&#60;frxDBDataset1.&#34;QTDE&#34;&#62; *  &#60;frxDBDataset1.&#34;PESO&#34;&#62;);    &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure frxDBDataset1DESCRICAOOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;end.    " PropData="">
