<TfrxReport Version="5.3.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="45131,4296712037" ScriptLanguage="PascalScript" ScriptText.Text="{var TB : Extended;&#13;&#10;    DescGeral, DescTotal, TotalCusto, VendaGeral, X :Real;    &#13;&#10;    Pedidos :String;                                            &#13;&#10;  &#13;&#10;procedure ReportTitle1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TOTALBRUTO.Text := '';&#13;&#10;  TB := 0;&#13;&#10;  DescGeral :=0;&#13;&#10;  DescTotal :=0;&#13;&#10;  TotalCusto:=0;&#13;&#10;  VendaGeral:=0;&#13;&#10;  Pedidos :='';                                   &#13;&#10;end;&#13;&#10;&#13;&#10;procedure LUCROBRUTOOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;LUCROBRUTO&#62; &#60;&#62; null then                                                                &#13;&#10;  TB := TB+&#60;LUCROBRUTO&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin                                      &#13;&#10;   TOTALBRUTO.Text := 'LUCRO BRUTO TOTAL: R$ '+FormatFloat(',0.00',((TB + &#60;DescTotal&#62;) - TotalCusto ) );&#13;&#10;   MEMO16.text     := 'LUCRO BRUTO % :   '+FormatFloat('0.00',((((TB + &#60;DescTotal&#62;) - TotalCusto) / (VendaGeral + &#60;DescTotal&#62;) )) * 100);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SysMemo6OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Pedidos :=Pedidos + ' '+&#60;dbdConsulta.&#34;NROPEDIDO&#34;&#62;;                                              &#13;&#10;end;&#13;&#10;&#13;&#10;procedure SysMemo6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   DescGeral :=&#60;dbdConsulta.&#34;DESC_ACRE&#34;&#62;;&#13;&#10;   if pos(&#60;dbdConsulta.&#34;NROPEDIDO&#34;&#62;,Pedidos) &#62; 0 then&#13;&#10;   begin               &#13;&#10;     DescGeral :=0;&#13;&#10;   end;               &#13;&#10;      &#13;&#10;  DescTotal :=DescTotal + DescGeral;  &#13;&#10;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalCusto := TotalCusto + (&#60;dbdConsulta.&#34;VR_CUSTO&#34;&#62; * &#60;dbdConsulta.&#34;QUANTIDADE&#34;&#62;);  &#13;&#10;  VendaGeral := VendaGeral + (&#60;dbdConsulta.&#34;VR_VENDA&#34;&#62; + &#60;dbdConsulta.&#34;DESC_ITEM&#34;&#62;) * &#60;dbdConsulta.&#34;QUANTIDADE&#34;&#62;;  &#13;&#10;end;         }  &#13;&#10;&#13;&#10;procedure dbdConsultaDESCRICAOOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if  TRIM(&#60;dbdConsulta.&#34;DESCRICAO&#34;&#62;) = 'ZZZTOTAL DE DESCONTOS' THEN           &#13;&#10;    dbdConsultaDESCRICAO.TEXT := 'TOTAL DE DESCONTOS'&#13;&#10;  else&#13;&#10;    dbdConsultaDESCRICAO.TEXT := &#60;dbdConsulta.&#34;DESCRICAO&#34;&#62;;        &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure SysMemo17OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo16OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxReport1OnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not MasterData1.DataSet.HasField('DESC_PROMOCAO') then  &#13;&#10;  begin&#13;&#10;    TotalDesconto.Text      := '';&#13;&#10;    LBTotalDesconto.Visible := False;                                              &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  edtEmpresa.Visible := not (&#60;AGRUPA_EMPRESA&#62; = 'S');&#13;&#10;  dbedtEmpresa.Visible := not (&#60;AGRUPA_EMPRESA&#62; = 'S');  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;                &#13;&#10;end." OnStartReport="frxReport1OnStartReport">
