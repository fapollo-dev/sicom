<TfrxReport Version="5.3.16" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39743,7359512384" ReportOptions.Description.Text="" ReportOptions.LastChange="45859,6598655671" ScriptLanguage="PascalScript" ScriptText.Text="var Linha, MaxLinha, Pag : Integer;&#13;&#10;  &#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   if (MaxLinha=&#60;Line#&#62;)then&#13;&#10;   begin&#13;&#10;                                            &#13;&#10;      Engine.NewPage;&#13;&#10;      MaxLinha := &#60;Line#&#62;+&#60;dbeEmpresa.&#34;NUMEITENSNOTA&#34;&#62;+1;&#13;&#10;   end;&#13;&#10;   line.visible := MasterData1.Dataset.recno = 10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(Linha);                      &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure ReportTitle1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MaxLinha := &#60;dbeEmpresa.&#34;NUMEITENSNOTA&#34;&#62;+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; Linha    := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure dbdNotaTIPOFRETEOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dbdNota.&#34;TIPOFRETE&#34;&#62; = '1' then               &#13;&#10;    dbdNotaTIPOFRETE.text := '0'&#13;&#10;  else&#13;&#10;    dbdNotaTIPOFRETE.text := '1';        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure mmTipoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dbdNota.&#34;TIPO&#34;&#62; = 'E' then               &#13;&#10;    mmTipo.text := '0'&#13;&#10;  else&#13;&#10;    mmTipo.text := '1';  &#13;&#10;end;                            &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure ColumnHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Page#&#62; &#62; 1 then&#13;&#10;     ColumnHeader1.Visible := False&#13;&#10;  else&#13;&#10;     ColumnHeader1.Visible := True;  &#13;&#10;&#13;&#10;  if &#60;dbdNota.&#34;STATUSNFE&#34;&#62; = 'C' then&#13;&#10;    mmCan.Visible := True&#13;&#10;  else              &#13;&#10;    mmCan.Visible := False;                     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure SetaVisible(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    TfrxMemoView(Sender).Visible := False;                                           &#13;&#10;end;&#13;&#10;    &#13;&#10;procedure Memo103OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure dbdNotaOBSOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   dbdNotaOBS.Text := &#60;dbdNota.&#34;OBS&#34;&#62;;&#13;&#10;   if (&#60;dbeEmpresa.&#34;CLASSFISCAL&#34;&#62; = 'SN') and (&#60;dbdNota.&#34;TOTALBASEICM&#34;&#62;&#62;0) and (&#60;dbdNota.&#34;TITULAR_TIPO&#34;&#62; = 'J') then&#13;&#10;   begin               &#13;&#10;     dbdNotaOBS.Text := dbdNotaOBS.Text + #13 +&#13;&#10;     'PERMITE O APROVEITAMENTO DE CREDITO DE ICMS NO VALOR DE R$' + &#13;&#10;     FormatFloat('0.00', &#60;dbdNota.&#34;TOTALBASEICM&#34;&#62;) +&#13;&#10;     ' CORRESPONDENTE À ALIQUOTA DE ' +  FormatFloat('0.00', &#60;dbeEmpresa.&#34;ALQSIMPLESNAC&#34;&#62;) + &#13;&#10;     '% NOS TERMOS DO ART.23 DA LC 123';&#13;&#10;   end;               &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;end.          ">
