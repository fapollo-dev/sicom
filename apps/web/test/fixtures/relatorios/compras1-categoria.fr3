<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.15.13" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="43108,7378023495" ScriptLanguage="PascalScript" ScriptText.Text="{Marcelo - 03/11/2016                              &#13;&#10;O relatório funciona da seguinte forma:&#13;&#10;1. É agrupado na ordem Empresa-Data-Seção-Departamento-Grupo-Subgrupo&#13;&#10;2. Como os totais ficaram no groupheader e não no groupfooter, foi necessário fazer alguns processos&#13;&#10;  2.1. O relatório foi configurado para imprimir em 2 passos.&#13;&#10;  2.2. No primeiro passo, no beforeprint dos groupfooters, os stringlists são alimentados.&#13;&#10;    2.2.1. O stringlist NomeX serve como busca e nele ficam os dados dos registros concatenados  &#13;&#10;    2.2.2. O stringlist ValorX serve para armazenar os valores dos grupos&#13;&#10;  2.3. No segundo passo, no beforeprint dos groupheaders, os valores são buscados.&#13;&#10;3. É necessário que exista um totalizador no groupfooter para conseguir pegar a soma através do código,&#13;&#10;   sem ele ocorre um erro. Como ele não deve ser exibido, seu Height foi colocado para 0, assim como o&#13;&#10;   do groupfooter. PORTANTO NÃO TIRAR!       &#13;&#10;}&#13;&#10;  &#13;&#10;&#13;&#10;var&#13;&#10;  NomeEmpresa, ValorEmpresa: TStringList;  &#13;&#10;  NomeData, ValorData: TStringList;&#13;&#10;  NomeSecao, ValorSecao: TStringList;&#13;&#10;  NomeDepartamento, ValorDepartamento: TStringList;&#13;&#10;  NomeGrupo, ValorGrupo: TStringList;&#13;&#10;  NomeSubgrupo, ValorSubgrupo: TStringList;&#13;&#10;&#13;&#10;procedure Add(Valor: string; var NomeStrList: TStringList; var ValorStrList: TStringList);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin                  &#13;&#10;    NomeStrList.Add(Valor);&#13;&#10;    ValorStrList.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;TOTAL_COMPRA&#34;&#62;, MasterData1, 1)));  &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure SetTotal(Valor: string; var NomeStrList: TStringList; var ValorStrList: TStringList; var Campo: TfrxMemoView);&#13;&#10;var&#13;&#10;  IndexOf: Integer;  &#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    IndexOf := NomeStrList.IndexOf(Valor);&#13;&#10;    if IndexOf &#60;&#62; -1 then                &#13;&#10;      Campo.Text := ValorStrList[IndexOf];                      &#13;&#10;  end;  &#13;&#10;end;          &#13;&#10;  &#13;&#10;procedure GroupHeader7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(IntToStr(&#60;DBDRelatorio.&#34;CODSUBGRUPO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODGRUPO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;           FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeSubgrupo,&#13;&#10;           ValorSubgrupo,&#13;&#10;           SomaSubGrupo                                    &#13;&#10;      );                            &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxReport1OnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  NomeEmpresa       := TStringList.Create;&#13;&#10;  ValorEmpresa      := TStringList.Create;    &#13;&#10;  NomeData          := TStringList.Create;&#13;&#10;  ValorData         := TStringList.Create;    &#13;&#10;  NomeSecao         := TStringList.Create;&#13;&#10;  ValorSecao        := TStringList.Create;&#13;&#10;  NomeDepartamento  := TStringList.Create;&#13;&#10;  ValorDepartamento := TStringList.Create;      &#13;&#10;  NomeGrupo         := TStringList.Create;&#13;&#10;  ValorGrupo        := TStringList.Create;    &#13;&#10;  NomeSubgrupo      := TStringList.Create;&#13;&#10;  ValorSubgrupo     := TStringList.Create;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxReport1OnStopReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  NomeEmpresa.Free;&#13;&#10;  ValorEmpresa.Free;    &#13;&#10;  NomeData.Free;&#13;&#10;  ValorData.Free;    &#13;&#10;  NomeSecao.Free;&#13;&#10;  ValorSecao.Free;&#13;&#10;  NomeDepartamento.Free;&#13;&#10;  ValorDepartamento.Free;    &#13;&#10;  NomeGrupo.Free;&#13;&#10;  ValorGrupo.Free;                                    &#13;&#10;  NomeSubgrupo.Free;&#13;&#10;  ValorSubgrupo.Free;                            &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(IntToStr(&#60;DBDRelatorio.&#34;CODSUBGRUPO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODGRUPO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;      FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeSubgrupo,&#13;&#10;      ValorSubgrupo);      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(IntToStr(&#60;DBDRelatorio.&#34;CODGRUPO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;      FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeGrupo,&#13;&#10;      ValorGrupo);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(IntToStr(&#60;DBDRelatorio.&#34;CODGRUPO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;           FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeGrupo,&#13;&#10;           ValorGrupo,&#13;&#10;           SomaGrupo                                    &#13;&#10;      );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;           FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeDepartamento,&#13;&#10;           ValorDepartamento,&#13;&#10;           SomaDepartamento                                                          &#13;&#10;      );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(IntToStr(&#60;DBDRelatorio.&#34;CODDPTO&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;      FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeDepartamento,&#13;&#10;      ValorDepartamento);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;           FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeSecao,&#13;&#10;           ValorSecao,&#13;&#10;           SomaSecao                                                                  &#13;&#10;      );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(IntToStr(&#60;DBDRelatorio.&#34;CODSECAO&#34;&#62;) + '|' +&#13;&#10;      FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeSecao,&#13;&#10;      ValorSecao);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;      IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeData,&#13;&#10;      ValorData);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(FormatDateTime('dd/mm/yyyy', &#60;DBDRelatorio.&#34;DATA&#34;&#62;) + '|' +&#13;&#10;           IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeData,&#13;&#10;           ValorData,&#13;&#10;           SomaData                                                                        &#13;&#10;      );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Add(IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;      NomeEmpresa,&#13;&#10;      ValorEmpresa);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetTotal(IntToStr(&#60;DBDRelatorio.&#34;IDEMPRESA&#34;&#62;),&#13;&#10;           NomeEmpresa,&#13;&#10;           ValorEmpresa,&#13;&#10;           SomaEmpresa                                                                                    &#13;&#10;      );  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  case &#60;DBDVariaveisAdicionais.&#34;NiveisExpandidos&#34;&#62; of&#13;&#10;    1: GroupHeader3.ExpandDrillDown := True;     &#13;&#10;    2:&#13;&#10;    begin&#13;&#10;      GroupHeader3.ExpandDrillDown := True;&#13;&#10;      GroupHeader2.ExpandDrillDown := True;  &#13;&#10;    end;              &#13;&#10;    3:&#13;&#10;    begin&#13;&#10;      GroupHeader3.ExpandDrillDown := True;&#13;&#10;      GroupHeader2.ExpandDrillDown := True;&#13;&#10;      GroupHeader4.ExpandDrillDown := True;  &#13;&#10;    end;&#13;&#10;    4:&#13;&#10;    begin&#13;&#10;      GroupHeader3.ExpandDrillDown := True;&#13;&#10;      GroupHeader2.ExpandDrillDown := True;&#13;&#10;      GroupHeader4.ExpandDrillDown := True;      &#13;&#10;      GroupHeader5.ExpandDrillDown := True;          &#13;&#10;    end;&#13;&#10;    5:&#13;&#10;    begin&#13;&#10;      GroupHeader3.ExpandDrillDown := True;&#13;&#10;      GroupHeader2.ExpandDrillDown := True;&#13;&#10;      GroupHeader4.ExpandDrillDown := True;      &#13;&#10;      GroupHeader5.ExpandDrillDown := True;&#13;&#10;      GroupHeader6.ExpandDrillDown := True;          &#13;&#10;    end;                &#13;&#10;  end;  &#13;&#10;end." StoreInDFM="False" OnStartReport="frxReport1OnStartReport" OnStopReport="frxReport1OnStopReport" PropData="">
