<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.12.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40227,7205777894" ReportOptions.Description.Text="" ReportOptions.LastChange="41060,7530273264" ScriptLanguage="PascalScript" ScriptText.Text="procedure Memo8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'E' then&#13;&#10;    Memo8.text := 'ENTRADAS'&#13;&#10;  else IF &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'S' THEN                       &#13;&#10;    Memo8.text := 'SAIDAS'&#13;&#10;  ELSE&#13;&#10;    Memo8.text := &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62;;        &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Subreport1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin           &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'E' then&#13;&#10;  begin              &#13;&#10;    SubreportS.visible := False;&#13;&#10;    SubreportE.visible := True;                                                &#13;&#10;  end                &#13;&#10;  else&#13;&#10;  begin              &#13;&#10;    SubreportS.visible := True;&#13;&#10;    SubreportE.visible := False;&#13;&#10;  end;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo21OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var texto: String;                                      &#13;&#10;begin&#13;&#10;  if Copy(&#60;frxDBDatasetCFOPE.&#34;CFOP&#34;&#62;,1,1) = '1' then&#13;&#10;    texto := 'Do Estado'  &#13;&#10;  else if Copy(&#60;frxDBDatasetCFOPE.&#34;CFOP&#34;&#62;,1,1) = '2' then&#13;&#10;   texto := 'De Outros Estados'&#13;&#10;  else if Copy(&#60;frxDBDatasetCFOPE.&#34;CFOP&#34;&#62;,1,1) = '3' then&#13;&#10;    texto := Memo21.text + 'Do Exterior';  &#13;&#10;  Memo21.text := Copy(&#60;frxDBDatasetCFOPE.&#34;CFOP&#34;&#62;,1,1) + '.00 '+ texto;        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var texto: String;                                      &#13;&#10;begin&#13;&#10;  if Copy(&#60;frxDBDatasetCFOP.&#34;CFOP&#34;&#62;,1,1) = '5' then&#13;&#10;    texto := 'Do Estado'  &#13;&#10;  else if Copy(&#60;frxDBDatasetCFOP.&#34;CFOP&#34;&#62;,1,1) = '6' then&#13;&#10;   texto := 'De Outros Estados'&#13;&#10;  else if Copy(&#60;frxDBDatasetCFOP.&#34;CFOP&#34;&#62;,1,1) = '7' then&#13;&#10;    texto := Memo21.text + 'Do Exterior';  &#13;&#10;  Memo20.text := Copy(&#60;frxDBDatasetCFOP.&#34;CFOP&#34;&#62;,1,1) + '.00 '+ texto;        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo31OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var Pagina :Integer;                                  &#13;&#10;begin&#13;&#10; if &#60;Page#&#62; &#60;= 1 then&#13;&#10;     begin&#13;&#10;       Pagina  := &#60;FOLHA&#62;;                                      &#13;&#10;       Memo31.Text := inttostr(Pagina);&#13;&#10;       Memo38.Text := inttostr(Pagina);           &#13;&#10;     end             &#13;&#10;     else     &#13;&#10;     begin&#13;&#10;       if Memo31.Text = '' then&#13;&#10;       begin                   &#13;&#10;       Pagina := Pagina + 1;&#13;&#10;       Memo31.Text := inttostr(Pagina);&#13;&#10;       Memo38.Text := inttostr(Pagina);           &#13;&#10;       end;                 &#13;&#10;     end;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo26OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo12OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'E' then&#13;&#10;    Memo12.text := 'Operação com crédito de imposto'&#13;&#10;  else IF &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'S' THEN                       &#13;&#10;    Memo12.text := 'Operação com débito de imposto';  &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'E' then&#13;&#10;    Memo13.text := 'Operação sem crédito de imposto'  &#13;&#10;&#13;&#10;  else IF &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'S' THEN                       &#13;&#10;    Memo13.text := 'Operação sem débito de imposto';    &#13;&#10;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo15OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;   if &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'E' then&#13;&#10;    Memo15.text := 'Imposto Creditado'  &#13;&#10;&#13;&#10;  else IF &#60;frxDBDatasetTemp.&#34;TIPO&#34;&#62; = 'S' THEN                       &#13;&#10;    Memo15.text := 'Imposto Debitado';    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo38OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin                                        &#13;&#10; // Memo38.Text :=  &#60;FOLHA&#62; + 1;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
