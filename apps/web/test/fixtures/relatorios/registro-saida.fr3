<TfrxReport Version="4.12.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40227,7205777894" ReportOptions.Description.Text="" ReportOptions.LastChange="41060,745931956" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;procedure SetaHeigth(Sender: TfrxComponent);&#13;&#10;var Numero: Integer;&#13;&#10;       &#13;&#10;begin&#13;&#10;   Numero := MasterData2.DataSet.RecordCount;                                                           &#13;&#10;   if(Numero = 0) then&#13;&#10;     Numero := 1;&#13;&#10;       &#13;&#10;   TfrxMemoView(Sender).Height := MasterData2.DataSet.RecordCount *19;&#13;&#10;&#13;&#10;          &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Subreport1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetaHeigth(Sender);&#13;&#10;  SetaHeigth(MasterData1);                                  &#13;&#10;end;&#13;&#10;&#13;&#10;    &#13;&#10;procedure Memo31OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var  Pagina :Integer;                                                       &#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;   begin               &#13;&#10;     if &#60;Page#&#62; &#60;= 1 then&#13;&#10;     begin&#13;&#10;       Pagina  := &#60;FOLHA&#62;;                                      &#13;&#10;       Memo31.Text := inttostr(Pagina);  &#13;&#10;       Memo29.Text := 'T O T A L   P A G : '+ IntToStr(Pagina);                         &#13;&#10;     end             &#13;&#10;     else     &#13;&#10;     begin&#13;&#10;       if Memo31.Text = '' then&#13;&#10;       begin                   &#13;&#10;       Pagina := Pagina + 1;&#13;&#10;       Memo31.Text := inttostr(Pagina);&#13;&#10;       Memo29.Text := 'T O T A L   P A G : '+ IntToStr(Pagina);&#13;&#10;       end;                 &#13;&#10;     end;&#13;&#10;   end;                 &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure frxDBDatasetCFOP_ICMSOUTRASOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;               &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;(*        &#13;&#10;  if (MasterData2.Dataset.RecordCount = MasterData2.Dataset.RecNo + 2)  or&#13;&#10;     (&#60;frxDBDatasetCFOP_ICMS.&#34;ESPECIE&#34;&#62; = 'NF') then                 &#13;&#10;  begin              &#13;&#10;     mmOUTRAS.text :=  FormatFloat('0.0', &#60;frxDBDatasetCFOP_ICMS.&#34;OUTRAS&#34;&#62;);&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin                &#13;&#10;     mmOUTRAS.text :=  FormatFloat('0.0', 0);&#13;&#10;  end; *)          &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure mmCFOPOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  frxDBDatasetCFOP_ICMSOUTRAS.text := '';         &#13;&#10;  if (&#60;frxDBDatasetCFOP_ICMS.&#34;ESPECIE&#34;&#62; = 'NF')  then&#13;&#10;  begin              &#13;&#10;     mmCFOP.text :=&#60;frxDBDatasetCFOP_ICMS.&#34;CFOP&#34;&#62;;&#13;&#10;     frxDBDatasetCFOP_ICMSOUTRAS.text := formatfloat('0.00',&#60;frxDBDatasetCFOP_ICMS.&#34;OUTRAS&#34;&#62;);         &#13;&#10;  end&#13;&#10;  else if(&#60;frxDBDatasetCFOP_ICMS.&#34;ESPECIE&#34;&#62; = 'MR') then                &#13;&#10;  begin                &#13;&#10;    if (MasterData2.Dataset.RecNo = 0) then                  &#13;&#10;     mmCFOP.text := '5102'&#13;&#10;    else if ((MasterData2.Dataset.RecordCount = MasterData2.Dataset.RecNo + 1)) then&#13;&#10;    begin                &#13;&#10;     mmCFOP.text := '5403';&#13;&#10;     frxDBDatasetCFOP_ICMSOUTRAS.text := formatfloat('0.00',&#60;frxDBDatasetCFOP_ICMS.&#34;OUTRAS&#34;&#62;);                                 &#13;&#10;    end;               &#13;&#10;  end;               &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxDBDatasetNFNRONFOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDatasetCFOP_ICMS.&#34;ESPECIE&#34;&#62; = 'NF')  then&#13;&#10;    frxDBDatasetNFNRONF.text := FormatFloat('000000000',&#60;frxDBDatasetNF.&#34;NRONF&#34;&#62;)&#13;&#10;  else&#13;&#10;    frxDBDatasetNFNRONF.text := &#60;frxDBDatasetNF.&#34;NRONF&#34;&#62;;                                    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
