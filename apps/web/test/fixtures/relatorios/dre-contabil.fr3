<TfrxReport Version="5.3.16" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39799,4567547338" ReportOptions.Description.Text="" ReportOptions.LastChange="43391,3760760764" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  vListaTotalNivel1, vListaTotalNivel2, vListaTotalNivel3, vListaTotalNivel4: TStringList;&#13;&#10;  vIndiceListaNivel1, vIndiceListaNivel2, vIndiceListaNivel3, vIndiceListaNivel4: Integer;&#13;&#10;  vTamInicial, vTamInicialMasterData, vTamInicialMemo: Double;                                                               &#13;&#10;&#13;&#10;procedure GroupHeaderNivel4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    try&#13;&#10;      MemTotalNivel4.Text := vListaTotalNivel4[vIndiceListaNivel4];&#13;&#10;      Inc(vIndiceListaNivel4);&#13;&#10;&#13;&#10;      if &#60;DBDRelatorio.&#34;CFGDRE_TIPO_CALCULO_NIVEL1&#34;&#62; = 'E' then&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel4.Height := 0;&#13;&#10;        GroupHeaderNivel5.Height := 0;            &#13;&#10;        MemExpandido.Height      := 0;&#13;&#10;        MemTotalNivel4.Height    := 0;                                                &#13;&#10;      end                    &#13;&#10;      else&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel4.Height := vTamInicial;&#13;&#10;        GroupHeaderNivel5.Height := vTamInicial;            &#13;&#10;        MemExpandido.Height      := vTamInicialMemo;&#13;&#10;        MemTotalNivel4.Height    := vTamInicialMemo;            &#13;&#10;      end;          &#13;&#10;    except&#13;&#10;    end;              &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeaderNivel2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    try&#13;&#10;      MemTotalNivel2.Text := vListaTotalNivel2[vIndiceListaNivel2];&#13;&#10;      Inc(vIndiceListaNivel2);&#13;&#10;              &#13;&#10;      if &#60;DBDRelatorio.&#34;CFGDRE_TIPO_CALCULO_NIVEL1&#34;&#62; = 'E' then&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel2.Height  := 0;&#13;&#10;        MemExpandidoNivel2.Height := 0;                              &#13;&#10;        MemTotalNivel2.Height     := 0;                                   &#13;&#10;      end                    &#13;&#10;      else&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel2.Height  := vTamInicial;&#13;&#10;        MemExpandidoNivel2.Height := vTamInicialMemo;                                                          &#13;&#10;        MemTotalNivel2.Height     := vTamInicialMemo;                                                     &#13;&#10;      end;&#13;&#10;    except&#13;&#10;    end;              &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeaderNivel5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    if &#60;DBDRelatorio.&#34;CFGDRE_TIPO_CALCULO_NIVEL1&#34;&#62; = 'E' then&#13;&#10;    begin&#13;&#10;      GroupHeaderNivel5.Height   := 0;        &#13;&#10;      MemLblHistorico.Height     := 0;&#13;&#10;      LineHistRodape.Frame.Width := 0;&#13;&#10;      LineHistTopo.Frame.Width   := 0;          &#13;&#10;      MemLblData.Height          := 0;&#13;&#10;      MemLblValor.Height         := 0;                                                &#13;&#10;    end                    &#13;&#10;    else&#13;&#10;    begin&#13;&#10;      GroupHeaderNivel5.Height   := vTamInicial;        &#13;&#10;      MemLblHistorico.Height     := vTamInicial;&#13;&#10;      LineHistRodape.Frame.Width := 1;&#13;&#10;      LineHistTopo.Frame.Width   := 1;          &#13;&#10;      MemLblData.Height          := vTamInicial;&#13;&#10;      MemLblValor.Height         := vTamInicial;          &#13;&#10;    end;                      &#13;&#10;  end;    &#13;&#10;end;    &#13;&#10;&#13;&#10;procedure GroupHeaderNivel1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    if &#60;DBDRelatorio.&#34;CFGDRE_TIPO_CALCULO_NIVEL1&#34;&#62; = 'E' then&#13;&#10;    begin&#13;&#10;      GroupHeaderNivel4.Height := 0;&#13;&#10;      GroupHeaderNivel5.Height := 0;&#13;&#10;      MemExpandido.Height      := 0;                                                                          &#13;&#10;    end                    &#13;&#10;    else&#13;&#10;    begin&#13;&#10;      GroupHeaderNivel4.Height := vTamInicial;&#13;&#10;      GroupHeaderNivel5.Height := vTamInicial;&#13;&#10;      MemExpandido.Height      := vTamInicialMemo;&#13;&#10;    end;                      &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooterNivel4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    vListaTotalNivel4.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR&#34;&#62;, MasterData, 1)));                &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooterNivel2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    vListaTotalNivel2.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR&#34;&#62;, MasterData, 1)));                &#13;&#10;  end;  &#13;&#10;end;    &#13;&#10;    &#13;&#10;procedure GroupFooterNivel1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    vListaTotalNivel1.Add(FormatFloat('##,###,#0.00', SUM(&#60;DBDRelatorio.&#34;VALOR&#34;&#62;, MasterData, 1)));                &#13;&#10;  end;            &#13;&#10;end;      &#13;&#10;&#13;&#10;procedure frxReportTotalizadoOnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  vListaTotalNivel1  := TStringList.Create;&#13;&#10;  vListaTotalNivel2  := TStringList.Create;&#13;&#10;  vListaTotalNivel3  := TStringList.Create;&#13;&#10;  vListaTotalNivel4  := TStringList.Create;      &#13;&#10;  vIndiceListaNivel1 := 0;&#13;&#10;  vIndiceListaNivel2 := 0;&#13;&#10;  vIndiceListaNivel3 := 0;&#13;&#10;  vIndiceListaNivel4 := 0;                     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxReportTotalizadoOnStopReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   vListaTotalNivel1.Free;&#13;&#10;   vListaTotalNivel2.Free;&#13;&#10;   vListaTotalNivel3.Free;&#13;&#10;   vListaTotalNivel4.Free;       &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  vIndiceListaNivel1 := 0;&#13;&#10;  vIndiceListaNivel2 := 0;&#13;&#10;  vIndiceListaNivel3 := 0;&#13;&#10;  vIndiceListaNivel4 := 0;      &#13;&#10;end;  &#13;&#10;&#13;&#10;procedure MasterDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;DBDRelatorio.&#34;VALOR&#34;&#62; = 0 then&#13;&#10;  begin&#13;&#10;    DBDRelatorioDATA_LANCAMENTO.Height := 0;&#13;&#10;    DBDRelatorioCODEMPRESA.Height      := 0;&#13;&#10;    DBDRelatorioHISTORICO.Height       := 0;&#13;&#10;    DBDRelatorioVALOR.Height           := 0;                          &#13;&#10;    MasterData.Height                  := 0;&#13;&#10;  end                &#13;&#10;  else&#13;&#10;  begin&#13;&#10;    DBDRelatorioDATA_LANCAMENTO.Height := vTamInicialMemo;&#13;&#10;    DBDRelatorioCODEMPRESA.Height      := vTamInicialMemo;&#13;&#10;    DBDRelatorioHISTORICO.Height       := vTamInicialMemo;&#13;&#10;    DBDRelatorioVALOR.Height           := vTamInicialMemo;                        &#13;&#10;    MasterData.Height                  := vTamInicialMasterData;&#13;&#10;  end;                                    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  vTamInicial           := GroupHeaderNivel1.Height;&#13;&#10;  vTamInicialMemo       := MemExpandidoNivel2.Height;&#13;&#10;  vTamInicialMasterData := MasterData.Height;                                          &#13;&#10;  try&#13;&#10;    case &#60;DBDVariaveisAdicionais.&#34;NiveisExpandidos&#34;&#62; of&#13;&#10;      1:&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel1.ExpandDrillDown := True;                                                      &#13;&#10;      end;&#13;&#10;      2:&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel1.ExpandDrillDown := True;&#13;&#10;        GroupHeaderNivel2.ExpandDrillDown := True;              &#13;&#10;      end;&#13;&#10;      3:&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel1.ExpandDrillDown := True;&#13;&#10;        GroupHeaderNivel2.ExpandDrillDown := True;&#13;&#10;        GroupHeaderNivel4.ExpandDrillDown := True;            &#13;&#10;      end;&#13;&#10;      4:&#13;&#10;      begin&#13;&#10;        GroupHeaderNivel1.ExpandDrillDown := True;&#13;&#10;        GroupHeaderNivel2.ExpandDrillDown := True;&#13;&#10;        GroupHeaderNivel4.ExpandDrillDown := True;              &#13;&#10;      end;          &#13;&#10;    end;        &#13;&#10;  except&#13;&#10;  end;            &#13;&#10;end." StoreInDFM="False" OnStartReport="frxReportTotalizadoOnStartReport" OnStopReport="frxReportTotalizadoOnStopReport">
