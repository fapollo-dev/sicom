<TfrxReport Version="4.15.13" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39765,6742319444" ReportOptions.Description.Text="" ReportOptions.LastChange="42957,545968912" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TotalVendas, Descontos, Acrescimos, Cancelamentos: Currency;&#13;&#10;    &#13;&#10;procedure GrpFinalizadorasOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalVendas := 0;               &#13;&#10;  Descontos   := 0;                &#13;&#10;  Acrescimos  := 0;           &#13;&#10;end;&#13;&#10;&#13;&#10;procedure VerificaFP(MasterData: TfrxMasterData; FormaPgto: string; Valor: Currency);  &#13;&#10;begin&#13;&#10;  if (UpperCase(FormaPgto) = 'TOTAL VENDA') or&#13;&#10;     (UpperCase(FormaPgto) = 'DESCONTOS') or&#13;&#10;     (UpperCase(FormaPgto) = 'ACR�SCIMOS') or&#13;&#10;     (UpperCase(FormaPgto) = 'CANCELAMENTOS') then&#13;&#10;  begin                     &#13;&#10;    if UpperCase(FormaPgto) = 'TOTAL VENDA' then&#13;&#10;      TotalVendas := Valor&#13;&#10;    else if UpperCase(FormaPgto) = 'DESCONTOS' then&#13;&#10;      Descontos := Valor                               &#13;&#10;    else if UpperCase(FormaPgto) = 'ACR�SCIMOS' then&#13;&#10;      Acrescimos := Valor&#13;&#10;    else if UpperCase(FormaPgto) = 'CANCELAMENTOS' then  &#13;&#10;      Cancelamentos := Valor;&#13;&#10;&#13;&#10;    MasterData.Visible := False;&#13;&#10;  end&#13;&#10;  else              &#13;&#10;    MasterData.Visible := True;  &#13;&#10;end;          &#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  VerificaFP(MasterData1, &#60;FrxFinalizadoras.&#34;FORMA_PGTO&#34;&#62;, &#60;FrxFinalizadoras.&#34;VALOR&#34;&#62;);              &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  VerificaFP(MasterData2, &#60;FrxDBTotais.&#34;FORMA_PGTO&#34;&#62;, &#60;FrxDBTotais.&#34;VALOR&#34;&#62;);  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;        &#13;&#10;end." OnStartReport="FrxRelatorioOnStartReport" OnStopReport="FrxRelatorioOnStopReport" PropData="">
