<TfrxReport Version="4.6.5" DotMatrixReport="True" EngineOptions.PrintIfEmpty="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39743,7359512384" ReportOptions.Description.Text="" ReportOptions.LastChange="39744,5455164931" ScriptLanguage="PascalScript" ScriptText.Text="var Linha, MaxLinha : Integer;&#13;&#10;  &#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   if (MaxLinha=&#60;Line#&#62;)then&#13;&#10;   begin&#13;&#10;      Engine.NewPage;&#13;&#10;      MaxLinha := &#60;Line#&#62;+&#60;dbeEmpresa.&#34;NUMEITENSNOTA&#34;&#62;+1;&#13;&#10;   end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(Linha);                      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ColumnFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   while Linha&#60;=&#60;dbeEmpresa.&#34;NUMEITENSNOTA&#34;&#62; do&#13;&#10;   begin&#13;&#10;      Engine.ShowBand(cldCompNota);&#13;&#10;      Inc(Linha);&#13;&#10;   end;&#13;&#10;     &#13;&#10;   if MasterData1.DataSet.Eof then&#13;&#10;   begin&#13;&#10;      ValorICMS.Text := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALICM&#34;&#62;);&#13;&#10;      IPI.Text       := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALIPI&#34;&#62;);  &#13;&#10;      BaseICMS.Text  := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALBASEICM&#34;&#62;);     &#13;&#10;      BaseSubst.Text := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALBASEICMT&#34;&#62;);     &#13;&#10;      TotalProd.Text := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALPROD&#34;&#62;);    &#13;&#10;      Seguro.Text    := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALSEGURO&#34;&#62;);    &#13;&#10;      Frete.Text     := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALFRETE&#34;&#62;);        &#13;&#10;      Acessorias.Text:= FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALACESSORIAS&#34;&#62;);&#13;&#10;      ValorSubst.Text:= FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALICM_ST&#34;&#62;);&#13;&#10;      TotalNota.Text := FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALNOTA&#34;&#62;);&#13;&#10;        &#13;&#10;      DESCONTO_FINAL.Visible := &#60;dbdNota.&#34;TOTALDESCFINAL&#34;&#62;&#62;0;                                  &#13;&#10;      DESCONTO_FINAL.Text    := 'DESCONTO FINAL : '+FormatFloat(',0.00',&#60;dbdNota.&#34;TOTALDESCFINAL&#34;&#62;)&#13;&#10;   end&#13;&#10;   else&#13;&#10;   begin&#13;&#10;      ValorICMS.Text := '----';&#13;&#10;      IPI.Text       := '----';  &#13;&#10;      BaseICMS.Text  := '----';     &#13;&#10;      BaseSubst.Text := '----';     &#13;&#10;      TotalProd.Text := '----';    &#13;&#10;      Seguro.Text    := '----';    &#13;&#10;      Frete.Text     := '----';    &#13;&#10;      Acessorias.Text:= '----';&#13;&#10;      ValorSubst.Text:= '----';&#13;&#10;      TotalNota.Text := '----';                           &#13;&#10;   end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportTitle1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MaxLinha := &#60;dbeEmpresa.&#34;NUMEITENSNOTA&#34;&#62;+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    Linha    := 0;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;end.          " PropData="">
