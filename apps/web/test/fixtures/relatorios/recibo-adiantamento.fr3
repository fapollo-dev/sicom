<TfrxReport Version="4.15.13" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42930,4749720949" ReportOptions.Description.Text="" ReportOptions.LastChange="42930,6056959607" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;DbdRelatorio.&#34;TIPO&#34;&#62; = 'D' then&#13;&#10;  begin&#13;&#10;    MemTexto.Text := 'Eu, ' + &#60;DbdRelatorio.&#34;RAZAO&#34;&#62;  + ' recebi um adiantamento da empresa ' + &#60;DbdRelatorio.&#34;FANTASIA&#34;&#62; +&#13;&#10;                     ', no dia ' + FormatDateTime('dd/mm/yyyy', &#60;DbdRelatorio.&#34;DTADIANTAMENTO&#34;&#62;) + ', no valor de ' + FormatFloat('0.00', &#60;DbdRelatorio.&#34;VALOR&#34;&#62;) + &#13;&#10;                     ' (' + Trim(NumeroExtenso(&#60;DbdRelatorio.&#34;VALOR&#34;&#62;)) + ') reais.';&#13;&#10;    MemResponsavel.Text := &#60;DbdRelatorio.&#34;RAZAO&#34;&#62;;                                                          &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    MemTexto.Text := 'Eu, ' + &#60;DbdRelatorio.&#34;FANTASIA&#34;&#62;  + ' recebi um adiantamento de ' + &#60;DbdRelatorio.&#34;RAZAO&#34;&#62; +&#13;&#10;                     ', no dia ' + FormatDateTime('dd/mm/yyyy', &#60;DbdRelatorio.&#34;DTADIANTAMENTO&#34;&#62;) + ', no valor de ' + FormatFloat('0.00', &#60;DbdRelatorio.&#34;VALOR&#34;&#62;) +&#13;&#10;                     ' (' + Trim(NumeroExtenso(&#60;DbdRelatorio.&#34;VALOR&#34;&#62;)) + ') reais.';                         &#13;&#10;    MemResponsavel.Text := &#60;DbdRelatorio.&#34;FANTASIA&#34;&#62;;  &#13;&#10;  end;            &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="044C65667403C00103546F70025808446174617365747301010C3200000020446174615365743D2244626452656C61746F72696F2220446174615365