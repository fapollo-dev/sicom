<TfrxReport Version="4.15.13" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40091,6795500579" ReportOptions.Description.Text="" ReportOptions.LastChange="42930,5937217245" ScriptLanguage="PascalScript" ScriptText.Text="var TotalPed, TotalGeral, TotalRCB, TotalAPG, X, Y, Z: Real;                                                 &#13;&#10;procedure ReportTitle1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalPed   := 0;&#13;&#10;  TotalGeral := 0;&#13;&#10;  TotalRCB   := 0;                                                 &#13;&#10;  X          := 0;&#13;&#10;  Y          := 0;&#13;&#10;  Z          := 0;                 &#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoTotalPedOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   MemoTotalPed.Text := FormatFloat(',0.00',TotalPed);&#13;&#10;   TotalPed := 0;                                     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoOP_PedOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalPed := TotalPed + &#60;dbdbusca.&#34;VALOR&#34;&#62;;&#13;&#10;  TotalGeral :=Totalgeral + &#60;dbdbusca.&#34;VALOR&#34;&#62;;                                                         &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalRCB :=TotalRCB + &#60;dbdRecebidos.&#34;VALOR_PAGO&#34;&#62;;                                                   &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalAPG :=TotalAPG + &#60;dbdPagados.&#34;VALOR_PAGO&#34;&#62;;       &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure memSaldoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var Result :Real;                                 &#13;&#10;begin&#13;&#10;  Result := (TotalGeral + TotalRCB) - TotalAPG;                                                                                                       &#13;&#10;  MemSaldo.text :='Saldo: '+formatFloat(',0.00',Result);                                                                                   &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxDBDatasetHistTABELAOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; frxDBDatasetHistTABELA.Color := clSkyBlue;&#13;&#10; if &#60;frxDBDatasetHist.&#34;TABELA&#34;&#62; = 'PEDIDO DE COMPRA' then&#13;&#10;   frxDBDatasetHistTABELA.Color := clMoneyGreen;     &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
