f &#60;TIPOQUERY&#62; = 0 then&#13;&#10;       tipoQuery := ' VENDAS'&#13;&#10;   else if &#60;TIPOQUERY&#62; = 1 then&#13;&#10;       tipoQuery := ' PEDIDOS'&#13;&#10;   else&#13;&#10;       tipoQuery := ' ENTRADA E SAÍDAS ';          &#13;&#10;&#13;&#10;  memo8.text :=  tipoQuery ;&#13;&#10;&#13;&#10;&#13;&#10; if &#60;MOSTRAR_CUSTO&#62; = 0 then&#13;&#10; begin                &#13;&#10;   dbdPorPeriodoCUSTO.Visible := False;&#13;&#10;   dbdPorPeriodoVRCUSTOREP.Visible := False;                                                &#13;&#10;   memo13.visible := false;&#13;&#10;   memo14.Visible := false;                                                                 &#13;&#10; end              &#13;&#10;  else&#13;&#10;  begin&#13;&#10;   dbdPorPeriodoCUSTO.Visible := True;&#13;&#10;   dbdPorPeriodoVRCUSTOREP.Visible := True;       &#13;&#10;   memo13.visible := True;&#13;&#10;   memo14.Visible := True;       &#13;&#10;  end;                    &#13;&#10;&#13;&#10;                               &#13;&#10;                                  &#13;&#10;end.">
