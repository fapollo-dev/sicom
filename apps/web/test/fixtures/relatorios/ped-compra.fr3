<TfrxReport Version="5.3.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39799,6724103009" ReportOptions.Description.Text="" ReportOptions.LastChange="43518,6677170949" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TotalGeral, TotalBonificado, vTopMemo39, vHeightmdPrincipal : Real;&#13;&#10;&#13;&#10;procedure dtdItensOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure mmTotalCustoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  mmTotalCusto.Text := 'Total da compra: ' + FormatFloat(',0.00', TotalGeral);&#13;&#10;  Memo35.Text := 'Total bonificado: ' + FormatFloat(',0.00', TotalBonificado);        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure grhPedidoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalGeral       :=0;&#13;&#10;  TotalBonificado  :=0;                             &#13;&#10;end;&#13;&#10;&#13;&#10;procedure mdPrincipalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Trim(&#60;frxDBPedidoCompra.&#34;DESCRICAO_SITUACAO&#34;&#62;) = '' then&#13;&#10;  begin&#13;&#10;    mdPrincipal.Height := vHeightmdPrincipal/2;            &#13;&#10;    Memo39.Top         := 0;                                            &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    mdPrincipal.Height := vHeightmdPrincipal;&#13;&#10;    Memo39.Top         := vTopMemo39;                        &#13;&#10;  end;            &#13;&#10;  &#13;&#10;  TotalGeral := TotalGeral + (&#60;frxDBPedidoCompra.&#34;QTDE&#34;&#62; * &#60;frxDBPedidoCompra.&#34;VLREMBALAGEM&#34;&#62;);&#13;&#10;  TotalBonificado := TotalBonificado +((&#60;frxDBPedidoCompra.&#34;QTDE&#34;&#62;*&#60;frxDBPedidoCompra.&#34;VLREMBALAGEM&#34;&#62;) * &#60;frxDBPedidoCompra.&#34;BONIFICACAO&#34;&#62;) / 100;       &#13;&#10;end;&#13;&#10;&#13;&#10;procedure frxDBPedidoCompraCODPGTOOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var Texto: String;                     &#13;&#10;begin&#13;&#10;  Texto := '';                          &#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := IntToStr(&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD2&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD2&#34;&#62;);&#13;&#10;    &#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD3&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD3&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD4&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD4&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD5&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD5&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD6&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD6&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD7&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + '-' + IntToStr(&#60;frxDBPedidoCompra.&#34;CD7&#34;&#62;);&#13;&#10;&#13;&#10;  if (&#60;frxDBPedidoCompra.&#34;CD8&#34;&#62;  &#60;&#62; 0) and ((&#60;frxDBPedidoCompra.&#34;CD1&#34;&#62;  &#60;&#62; null)) then&#13;&#10;    Texto := Texto + IntToStr(&#60;frxDBPedidoCompra.&#34;CD8&#34;&#62;);&#13;&#10;    &#13;&#10;  frxDBPedidoCompraCODPGTO.text := Texto;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  vTopMemo39         := Memo39.Top;                    &#13;&#10;  vHeightmdPrincipal := mdPrincipal.Height;                         &#13;&#10;end.">
